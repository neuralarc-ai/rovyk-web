# ── Waitlist mode ─────────────────────────────────────────────────────
# While this is "true", every "Download for …" button on the site becomes
# "Join the waitlist" and opens the signup dialog. Anything else — unset,
# "false", "1" — leaves the download CTAs alone.
#
# NEXT_PUBLIC_, so it is inlined into the browser bundle at build time.
# Changing it on the host does nothing until the next `next build`.
NEXT_PUBLIC_WAITLIST_MODE=true

# Canonical origin — the one place the site's address is written down.
# `lib/site.ts` reads it, and everything that needs a full URL goes
# through there: the canonical <link> and Open Graph tags on every page,
# and the footer of the confirmation email. Moving the domain is a change
# here plus a redeploy.
#
# No trailing slash needed — it is stripped. Set it per environment:
# NEXT_PUBLIC_ is inlined at build time, so a preview deploy that leaves
# it unset will advertise itself as the live site.
NEXT_PUBLIC_SITE_URL=https://rovyk-web.vercel.app

# ── SMTP ──────────────────────────────────────────────────────────────
# Server-only. Never add a NEXT_PUBLIC_ prefix to any of these, or the
# credentials ship to the browser.
SMTP_HOST=
# 587 for STARTTLS, 465 for implicit TLS. The route derives `secure` from
# this, so the port is the only thing to get right.
SMTP_PORT=587
# Also used verbatim as the From: address on both emails.
SMTP_USER=
SMTP_PASSWORD=

# Optional. Display name in the From: header. Defaults to "Team Rovyk".
SENDER_NAME=Team Rovyk
# Optional. Inbox that receives signup notifications, and — since there is
# no database — the only copy of the list. Defaults to hello@neuralarc.ai.
TEAM_NOTIFICATION_EMAIL=hello@neuralarc.ai
NEXT_PUBLIC_VOICE_MODE=false